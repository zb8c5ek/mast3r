# Base configuration for Batched DB Generator
# ============================================
# This gin config defines default parameters for batch processing.
# Override specific parameters in job-specific configs or burn scripts.

# Model Configuration
BatchedDBGenerator.model_name = "MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric"
BatchedDBGenerator.model_weights_dir = "checkpoints"

# Batch Processing Parameters
BatchedDBGenerator.batch_size = 50      # Number of images per batch
BatchedDBGenerator.overlap = 10         # Overlapping images between batches
BatchedDBGenerator.spacing = 1          # Frame spacing (1 = consecutive)
BatchedDBGenerator.start_frame = 0      # Frame index to start from

# Mapper Configuration
# Options: 'GLOMAP', 'COLMAP', or None to skip mapping
BatchedDBGenerator.mapper = None
